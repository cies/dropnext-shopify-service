{"openapi":"3.1.0","info":{"title":"DSS API","version":"v1","description":"Internal REST API for communication between the DropNext monolith and the DSS."},"tags":[],"paths":{"/api/shopify-service/v1/orders":{"post":{"summary":"Create a Shopify order","description":"Create a new Shopify order in the monolith. Called by the DSS when it receives\na new order webhook from Shopify. Orders are treated as immutable for now; later changes go\nthrough a separate tickets/disputes flow. Lines without an active quotation for the\nretailer/region/variant triple are persisted on the order but omitted from supplier orders.\n\nMoney amounts (`total_as_string`, `snapshot_of_price_as_string`) are decimal strings exactly\nas Shopify's APIs emit them: a dot decimal separator, no thousands separators, no currency\nsymbol (e.g. `\"109.97\"`). They must be non-negative; an amount finer than the order's\n`currency` allows (e.g. more than two decimals for EUR, any decimals for JPY) is rounded\nhalf-up to the currency's minor unit.\n\n`email` is the buyer's e-mail address as Shopify has it on the order. It is optional and\nnullable: an order without a customer (e.g. a POS sale) has none. It is protected customer\ndata in Shopify's terms, so it is stored with the order and never logged. It is not validated\n(Shopify is the source of truth); a blank value is stored as absent.\n\nA `200 OK` response means the order has been **durably persisted and queued for\nasynchronous processing** — not that supplier orders or balance transactions have\nbeen written yet. The downstream supplier-order planning, balance check, etc.,\nare performed by an internal background job.","tags":["/api/shopify-service/v1"],"parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"example-store","shopify_order_id":1234567890123,"name":"#1001","financial_status":"Paid","fulfillment_status":null,"created_at":"2026-04-25T10:30:00Z","shipping_address":{"first_name":"John","last_name":"Doe","address1":"123 Main Street","address2":"Apt 4B","city":"San Francisco","province":"California","province_code":"CA","country_code":"US","zip":"94102","phone":"+1-555-123-4567"},"line_items":[{"shopify_line_item_id":1234567890987,"product_variant_id":1111111111111,"quantity":2,"snapshot_of_variant_title":"Small - Blue","snapshot_of_product_title":"Classic T-Shirt","snapshot_of_price_as_string":"29.99"}],"total_as_string":"109.97","currency":"USD","email":"john.doe@example.com"},"schema":{"$ref":"#/components/schemas/CreateShopifyOrderRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"shopify_order_id":1},"schema":{"$ref":"#/components/schemas/CreateOrderResponse"}}}},"400":{"description":"Validation error (e.g. unknown variant, missing fields, unknown status).","content":{"application/json":{"example":{"error":"Validation error (e.g. unknown variant, missing fields, unknown status).","code":"BadRequest","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"Order already exists.","content":{"application/json":{"example":{"error":"Order already exists.","code":"InternalError","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"postApiShopify_serviceV1Orders","deprecated":false}},"/api/shopify-service/v1/product-variants":{"delete":{"summary":"Delete the variants of a product","description":"Soft-delete every variant of a product that no longer exists in Shopify. Called by the DSS\non a `products/delete` webhook, which carries only the product's Shopify id. A product\nunknown to the store, or one whose variants are already soft-deleted, answers `deleted: 0`.","tags":["/api/shopify-service/v1"],"parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"example-store","product_id":8000000001},"schema":{"$ref":"#/components/schemas/DeleteProductVariantsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"deleted":3},"schema":{"$ref":"#/components/schemas/DeleteProductVariantsResponse"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"deleteApiShopify_serviceV1Product_variants","deprecated":false},"get":{"summary":"List known Shopify variant IDs for a store","description":"List all Shopify variant IDs the monolith knows about for the store identified by\n`shopify_subdomain`. Used by the DSS to diff against the\nlive Shopify catalog. Soft-deleted variants are included (the DSS needs to see them to\navoid re-creating them).","tags":["/api/shopify-service/v1"],"parameters":[{"schema":{"type":"string"},"in":"query","name":"shopify_subdomain","required":true,"description":"The Shopify subdomain identifying the store"}],"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"product_variant_ids":[101,102,103]},"schema":{"$ref":"#/components/schemas/VariantIdsResponse"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"getApiShopify_serviceV1Product_variants","deprecated":false},"post":{"summary":"Bulk create or update product variants","description":"Upsert product variants identified by their Shopify variant ID. The fields delivered\nfrom Shopify are considered immutable in the monolith's portal UIs. The whole batch\nruns in a single transaction (all-or-nothing). Returns the number of rows affected.\n\n`price_as_string` is the decimal string Shopify's APIs emit: a dot decimal separator, no\nthousands separators, no currency symbol (e.g. `\"10.00\"`). It must be non-negative; an amount\nfiner than `price_currency` allows is rounded half-up to the currency's minor unit.","tags":["/api/shopify-service/v1"],"parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"example-store","product_variants":[{"product_variant_id":1111111111111,"product_id":2222222222222,"product_title":"Classic T-Shirt","product_description":"A comfortable classic t-shirt.","product_description_html":"<p>A comfortable classic t-shirt.</p>","product_vendor":"Acme","product_type":"Shirt","product_tags":["apparel","summer"],"product_handle":"classic-t-shirt","product_status":"active","product_images":["https://cdn.example.com/classic-t-shirt.jpg"],"product_published_at":"2026-04-01T10:30:00Z","product_created_at":"2026-03-15T08:00:00Z","product_updated_at":"2026-04-20T12:00:00Z","title":"Small - Blue","sku":"TSHIRT-S-BLUE","barcode":"0123456789012","price_as_string":"10.00","price_currency":"EUR","selected_options":[{"name":"Size","value":"Small"},{"name":"Color","value":"Blue"}],"image_url":"https://cdn.example.com/classic-t-shirt-s-blue.jpg"}]},"schema":{"$ref":"#/components/schemas/UpsertProductVariantsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"upserted":5},"schema":{"$ref":"#/components/schemas/UpsertProductVariantsResponse"}}}},"400":{"description":"Empty variants list.","content":{"application/json":{"example":{"error":"Empty variants list.","code":"BadRequest","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"409":{"description":"A variant is already registered under a different store.","content":{"application/json":{"example":{"error":"A variant is already registered under a different store.","code":"InternalError","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"postApiShopify_serviceV1Product_variants","deprecated":false}},"/api/shopify-service/v1/stores":{"get":{"summary":"Look up a store by Shopify subdomain","description":"Look up a store known to the monolith by its Shopify subdomain\n(e.g. `shopify_subdomain=acme-store`).","tags":["/api/shopify-service/v1"],"parameters":[{"schema":{"type":"string"},"in":"query","name":"shopify_subdomain","required":true,"description":"The Shopify subdomain (e.g. \"acme-store\")"}],"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"store_id":1,"shopify_shop_id":1234567890,"api_key":"shpat_..."},"schema":{"$ref":"#/components/schemas/StoreResponse"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"getApiShopify_serviceV1Stores","deprecated":false}},"/api/shopify-service/v1/stores/api-key":{"put":{"summary":"Set the Shopify access token for a store","description":"Called by the DSS after a successful app install to persist the store's\n`shopify_shop_id` and Shopify access token `api_key`. If the store already has a\n`shopify_shop_id` that differs from the request, the update is rejected to protect against\noverwriting another shop's token via a subdomain collision. A null `shopify_shop_id` (the DSS\ncould not learn it from Shopify) keeps the stored id and only replaces the token; a store that\nhas no id yet is then answered as not found, because a token cannot be stored without one.","tags":["/api/shopify-service/v1"],"parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"acme-downtown","shopify_shop_id":1234567890,"api_key":"shpat_..."},"schema":{"$ref":"#/components/schemas/UpdateStoreApiKeyRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"store_id":1},"schema":{"$ref":"#/components/schemas/UpdateStoreApiKeyResponse"}}}},"404":{"description":"Store not found.","content":{"application/json":{"example":{"error":"Store not found.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}}},"security":[],"operationId":"putApiShopify_serviceV1StoresApi_key","deprecated":false}}},"webhooks":{"sync-shipments-with-fulfillments":{"post":{"summary":"Sync DropNext shipments with Shopify fulfillments","description":"Sent when a supplier creates a shipment in DropNext (via Supplier API or supplier portal),\nor re-organizes (usually: splits) a supplier order by creating new shipments\n(only via the supplier portal for now).\n\nThe DSS should create our shipments as Fulfillments in Shopify, possibly splitting over\nFulfillmentOrders; while deleting existing shipments that are no longer relevant.\n\nThis is sent to `<DSS_BASE_URL>/sync-shipments-with-fulfillments`","parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"acme-downtown","shopify_order_id":1001,"shipments":[{"tracking_number":"1Z999AA10123456784","carrier":"UPS","tracking_url":"https://www.ups.com/track?tracknum=1Z999AA10123456784","line_items":[{"product_variant_id":101,"quantity":1}]}]},"schema":{"$ref":"#/components/schemas/SyncShipmentsWithFulfillmentsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"new_fulfillment_ids":[4001,4002]},"schema":{"$ref":"#/components/schemas/SyncShipmentsWithFulfillmentsResponse"}}}},"404":{"description":"Could not find the Shopify order in the store.","content":{"application/json":{"example":{"error":"Could not find the Shopify order in the store.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"429":{"description":"Shopify throttled the shop; retry after `retry_after_seconds`.","content":{"application/json":{"example":{"error":"Shopify throttled this shop.","code":"RateLimited","trace_id":"1a2b3c4d","retry_after_seconds":10},"schema":{"$ref":"#/components/schemas/ThrottledError"}}}}},"deprecated":false}},"products/catalog":{"get":{"summary":"Read the shop's whole catalog","description":"Sent when the monolith wants to know what a shop actually holds, so it can compare that with what it has\nmirrored and repair the difference. The DSS reads every variant Shopify has for the shop, grouped under its\nproduct, paging and pacing itself against the shop's rate budget.\n\nThe answer is complete or the call fails: there is no cursor and no \"stopped early\" flag, because the\nmonolith soft-deletes every variant the answer omits. A large catalog can take minutes, so this is called\nfrom a background job and never from a request someone is waiting on.\n\nThis is sent to `<DSS_BASE_URL>/products/catalog?shop=<subdomain>`","parameters":[{"schema":{"type":"string"},"in":"query","name":"shop","required":true,"description":"The Shopify subdomain of the shop to read (e.g. \"acme-store\")"}],"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"products":[{"product_id":8112233445566,"product_variant_ids":[44556677889900,44556677889901]}],"product_count":1,"product_variant_count":2,"next_request_after_seconds":0},"schema":{"$ref":"#/components/schemas/ShopCatalogResponse"}}}},"404":{"description":"The shop has no Shopify Admin token.","content":{"application/json":{"example":{"error":"The shop has no Shopify Admin token.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"429":{"description":"Shopify throttled the shop; retry after `retry_after_seconds`.","content":{"application/json":{"example":{"error":"Shopify throttled this shop.","code":"RateLimited","trace_id":"1a2b3c4d","retry_after_seconds":10},"schema":{"$ref":"#/components/schemas/ThrottledError"}}}}},"deprecated":false}},"products/fetch":{"post":{"summary":"Fetch the named products as product variant items","description":"Sent when the monolith needs the full data of specific products: a batch of a catalog repair, or the one or\ntwo products behind an order line whose variant was never mirrored. The DSS answers the variant items that\n`POST /product-variants` already takes, so the answer can be stored as it arrives.\n\nA product Shopify no longer has is not an error; its id comes back under `missing_product_ids` and the\nmonolith soft-deletes the variants it holds under it. One Shopify failure fails the whole call: a partial\nanswer would be counted as a batch done.\n\nThis is sent to `<DSS_BASE_URL>/products/fetch`","parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"acme-downtown","shopify_product_ids":[8112233445566,8112233445567]},"schema":{"$ref":"#/components/schemas/FetchProductsRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"product_variants":[{"product_variant_id":1111111111111,"product_id":2222222222222,"product_title":"Classic T-Shirt","product_description":"A comfortable classic t-shirt.","product_description_html":"<p>A comfortable classic t-shirt.</p>","product_vendor":"Acme","product_type":"Shirt","product_tags":["apparel","summer"],"product_handle":"classic-t-shirt","product_status":"active","product_images":["https://cdn.example.com/classic-t-shirt.jpg"],"product_published_at":"2026-04-01T10:30:00Z","product_created_at":"2026-03-15T08:00:00Z","product_updated_at":"2026-04-20T12:00:00Z","title":"Small - Blue","sku":"TSHIRT-S-BLUE","barcode":"0123456789012","price_as_string":"10.00","price_currency":"EUR","selected_options":[{"name":"Size","value":"Small"},{"name":"Color","value":"Blue"}],"image_url":"https://cdn.example.com/classic-t-shirt-s-blue.jpg"}],"missing_product_ids":[8112233445567],"next_request_after_seconds":3},"schema":{"$ref":"#/components/schemas/FetchProductsResponse"}}}},"404":{"description":"The shop has no Shopify Admin token.","content":{"application/json":{"example":{"error":"The shop has no Shopify Admin token.","code":"NotFound","trace_id":"1a2b3c4d"},"schema":{"$ref":"#/components/schemas/ApiError"}}}},"429":{"description":"Shopify throttled the shop; retry after `retry_after_seconds`.","content":{"application/json":{"example":{"error":"Shopify throttled this shop.","code":"RateLimited","trace_id":"1a2b3c4d","retry_after_seconds":10},"schema":{"$ref":"#/components/schemas/ThrottledError"}}}}},"deprecated":false}},"tracking-update":{"post":{"summary":"Push a tracking status update to Shopify","description":"Sent when the monolith receives a tracking status update (via AfterShip webhook).\nThe DSS should create a FulfillmentEvent in Shopify and return its ID.\n\nThis is sent to `<DSS_BASE_URL>/tracking-update`","parameters":[],"requestBody":{"content":{"application/json":{"example":{"shopify_subdomain":"acme-downtown","shopify_order_id":978001,"tracking_number":"1Z999AA10123456784","status":"in_transit","happened_at":"2026-04-02T08:30:00Z","message":"Package departed origin facility."},"schema":{"$ref":"#/components/schemas/TrackingUpdateRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"example":{"fulfillment_event_id":7001},"schema":{"$ref":"#/components/schemas/TrackingUpdateResponse"}}}},"429":{"description":"Shopify throttled the shop; retry after `retry_after_seconds`.","content":{"application/json":{"example":{"error":"Shopify throttled this shop.","code":"RateLimited","trace_id":"1a2b3c4d","retry_after_seconds":10},"schema":{"$ref":"#/components/schemas/ThrottledError"}}}}},"deprecated":false}}},"components":{"schemas":{"StoreResponse":{"type":"object","required":["store_id","shopify_shop_id","api_key"],"properties":{"store_id":{"type":"integer","format":"int64"},"shopify_shop_id":{"type":"integer","format":"int64"},"api_key":{"type":["string","null"]}}},"ApiError":{"type":"object","required":["error"],"properties":{"error":{"type":"string"},"code":{"type":["string","null"]},"trace_id":{"type":["string","null"]}}},"UpdateStoreApiKeyResponse":{"type":"object","required":["store_id"],"properties":{"store_id":{"type":"integer","format":"int64"}}},"UpdateStoreApiKeyRequest":{"type":"object","required":["shopify_subdomain","shopify_shop_id","api_key"],"properties":{"shopify_subdomain":{"type":"string"},"shopify_shop_id":{"type":["integer","null"],"format":"int64"},"api_key":{"type":"string"}}},"VariantIdsResponse":{"type":"object","required":["product_variant_ids"],"properties":{"product_variant_ids":{"type":"array","items":{"type":"integer","format":"int64"}}}},"UpsertProductVariantsResponse":{"type":"object","required":["upserted"],"properties":{"upserted":{"type":"integer","format":"int32"}}},"ProductStatus":{"type":"string","enum":["active","draft","archived"]},"SelectedOption":{"type":"object","required":["name","value"],"properties":{"name":{"type":"string"},"value":{"type":"string"}}},"ProductVariantItem":{"type":"object","required":["product_variant_id","product_id","product_title","product_description","product_description_html","product_vendor","product_type","product_tags","product_handle","product_status","product_images","product_published_at","product_created_at","product_updated_at","title","sku","barcode","price_as_string","price_currency","selected_options","image_url"],"properties":{"product_variant_id":{"type":"integer","format":"int64"},"product_id":{"type":"integer","format":"int64"},"product_title":{"type":"string"},"product_description":{"type":"string"},"product_description_html":{"type":"string"},"product_vendor":{"type":"string"},"product_type":{"type":"string"},"product_tags":{"type":"array","items":{"type":"string"}},"product_handle":{"type":"string"},"product_status":{"$ref":"#/components/schemas/ProductStatus"},"product_images":{"type":"array","items":{"type":"string"}},"product_published_at":{"type":["string","null"]},"product_created_at":{"type":"string"},"product_updated_at":{"type":"string"},"title":{"type":"string"},"sku":{"type":["string","null"]},"barcode":{"type":["string","null"]},"price_as_string":{"type":"string"},"price_currency":{"type":"string"},"selected_options":{"type":"array","items":{"$ref":"#/components/schemas/SelectedOption"}},"image_url":{"type":["string","null"]}}},"UpsertProductVariantsRequest":{"type":"object","required":["shopify_subdomain","product_variants"],"properties":{"shopify_subdomain":{"type":"string"},"product_variants":{"type":"array","items":{"$ref":"#/components/schemas/ProductVariantItem"}}}},"DeleteProductVariantsResponse":{"type":"object","required":["deleted"],"properties":{"deleted":{"type":"integer","format":"int32"}}},"DeleteProductVariantsRequest":{"type":"object","required":["shopify_subdomain","product_id"],"properties":{"shopify_subdomain":{"type":"string"},"product_id":{"type":"integer","format":"int64"}}},"CreateOrderResponse":{"type":"object","required":["shopify_order_id"],"properties":{"shopify_order_id":{"type":"integer","format":"int64"}}},"ShippingAddress":{"type":"object","required":["first_name","last_name","address1","address2","city","province","province_code","country_code","zip","phone"],"properties":{"first_name":{"type":["string","null"]},"last_name":{"type":["string","null"]},"address1":{"type":"string"},"address2":{"type":["string","null"]},"city":{"type":"string"},"province":{"type":["string","null"]},"province_code":{"type":["string","null"]},"country_code":{"type":"string"},"zip":{"type":["string","null"]},"phone":{"type":["string","null"]}}},"OrderLineItem":{"type":"object","required":["shopify_line_item_id","product_variant_id","quantity","snapshot_of_variant_title","snapshot_of_product_title","snapshot_of_price_as_string"],"properties":{"shopify_line_item_id":{"type":"integer","format":"int64"},"product_variant_id":{"type":"integer","format":"int64"},"quantity":{"type":"integer","format":"int32"},"snapshot_of_variant_title":{"type":"string"},"snapshot_of_product_title":{"type":"string"},"snapshot_of_price_as_string":{"type":"string"}}},"CreateShopifyOrderRequest":{"type":"object","required":["shopify_subdomain","shopify_order_id","name","financial_status","fulfillment_status","created_at","shipping_address","line_items","total_as_string","currency"],"properties":{"shopify_subdomain":{"type":"string"},"shopify_order_id":{"type":"integer","format":"int64"},"name":{"type":"string"},"financial_status":{"type":"string"},"fulfillment_status":{"type":["string","null"]},"created_at":{"type":"string"},"shipping_address":{"$ref":"#/components/schemas/ShippingAddress"},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/OrderLineItem"}},"total_as_string":{"type":"string"},"currency":{"type":"string"},"email":{"type":["string","null"]}}},"SyncShipmentsWithFulfillmentsResponse":{"type":"object","required":["new_fulfillment_ids"],"properties":{"new_fulfillment_ids":{"type":"array","items":{"type":"integer","format":"int64"}}}},"ThrottledError":{"type":"object","required":["error","code","trace_id","retry_after_seconds"],"properties":{"error":{"type":"string"},"code":{"type":["string","null"]},"trace_id":{"type":["string","null"]},"retry_after_seconds":{"type":"integer","format":"int32"}}},"ShipmentLineItem":{"type":"object","required":["product_variant_id","quantity"],"properties":{"product_variant_id":{"type":"integer","format":"int64"},"quantity":{"type":"integer","format":"int32"}}},"Shipment":{"type":"object","required":["tracking_number","carrier","tracking_url","line_items"],"properties":{"tracking_number":{"type":"string"},"carrier":{"type":["string","null"]},"tracking_url":{"type":["string","null"]},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/ShipmentLineItem"}}}},"SyncShipmentsWithFulfillmentsRequest":{"type":"object","required":["shopify_subdomain","shopify_order_id","shipments"],"properties":{"shopify_subdomain":{"type":"string"},"shopify_order_id":{"type":"integer","format":"int64"},"shipments":{"type":"array","items":{"$ref":"#/components/schemas/Shipment"}}}},"ShopCatalogProduct":{"type":"object","required":["product_id","product_variant_ids"],"properties":{"product_id":{"type":"integer","format":"int64"},"product_variant_ids":{"type":"array","items":{"type":"integer","format":"int64"}}}},"ShopCatalogResponse":{"type":"object","required":["products","product_count","product_variant_count","next_request_after_seconds"],"properties":{"products":{"type":"array","items":{"$ref":"#/components/schemas/ShopCatalogProduct"}},"product_count":{"type":"integer","format":"int32"},"product_variant_count":{"type":"integer","format":"int32"},"next_request_after_seconds":{"type":"integer","format":"int32"}}},"FetchProductsResponse":{"type":"object","required":["product_variants","missing_product_ids","next_request_after_seconds"],"properties":{"product_variants":{"type":"array","items":{"$ref":"#/components/schemas/ProductVariantItem"}},"missing_product_ids":{"type":"array","items":{"type":"integer","format":"int64"}},"next_request_after_seconds":{"type":"integer","format":"int32"}}},"FetchProductsRequest":{"type":"object","required":["shopify_subdomain","shopify_product_ids"],"properties":{"shopify_subdomain":{"type":"string"},"shopify_product_ids":{"type":"array","items":{"type":"integer","format":"int64"}}}},"TrackingUpdateResponse":{"type":"object","required":["fulfillment_event_id"],"properties":{"fulfillment_event_id":{"type":"integer","format":"int64"}}},"TrackingUpdateRequest":{"type":"object","required":["shopify_subdomain","shopify_order_id","tracking_number","status","happened_at","message"],"properties":{"shopify_subdomain":{"type":"string"},"shopify_order_id":{"type":"integer","format":"int64"},